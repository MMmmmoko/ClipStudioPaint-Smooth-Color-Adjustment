<?xml version="1.0" encoding="UTF-8"?>
<Window size="75%,75%" min_size="80,50" 
        caption="0,0,0,18" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,18"
        shadow_type="none" shadow_border_color="#CSPColor_CaptionFocus" shadow_attached="true" shadow_snap="true" layered_window="true"
        alpha="255" size_box="4,4,4,4" icon="public/caption/logo.ico">
    <VBox class="csp_window_frame" bkcolor="bk_wnd_darkcolor" visible="true">
        <!-- 标题栏区域 -->
        <HBox class="csp_window_caption" name="window_caption_bar">
            <Control/>
            <Button class="btn_wnd_fullscreen_11" height="stretch" width="24" name="fullscreenbtn" margin="0,0,0,2" tooltip_text="全屏，按ESC键可退出全屏"/>
            <Button class="btn_wnd_min_11" height="stretch" width="24" name="minbtn" margin="0,0,0,2" tooltip_text="最小化"/>
            <Box width="24" height="stretch" margin="0,0,0,2">
                <Button class="btn_wnd_max_11" height="stretch" width="stretch" name="maxbtn" tooltip_text="最大化"/>
                <Button class="btn_wnd_restore_11" height="stretch" width="stretch" name="restorebtn" visible="false" tooltip_text="还原"/>
            </Box>
            <Button class="btn_wnd_close_11 csp_window_close" name="closebtn" tooltip_text="关闭"/>
        </HBox>
        
        <!-- 工作区域，除了标题栏外的内容都放在这个大的Box区域 -->
        <Box>
            <VBox margin="0,0,0,0" valign="center" halign="center">
                <Label name="tooltip" text="一个简单窗口，带有标题栏和常规按钮。" height="100%" width="100%" text_align="hcenter,vcenter"/>        
            </VBox>
        </Box>
    </VBox>
</Window>