<?xml version="1.0" encoding="UTF-8"?>
<!--<Window size="500,240"-->
<Window 
        caption="0,0,0,18" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,18"
        shadow_type="none" shadow_border_color="#CSPColor_CaptionFocus" shadow_attached="true" shadow_snap="true" layered_window="true"
        alpha="255"  icon="public/caption/logo.ico"
		
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://tempuri.org/NIMDUISchema.xsd"
		>
	<VBox class="csp_window_frame" visible="true" height="auto" width="auto">
		<!-- 标题栏区域 -->
		<HBox class="csp_window_caption" name="window_caption_bar">
			<Control width="24"/>
			<Control/>
			<Label class="csp_window_title" name="text_Title" text_id="STRID_APPLYEFFECTS"/>
			<Control/>
			<Button class="btn_wnd_close_11 csp_window_close" name="btn_Close" tooltip_text_id="STRING_CLOSE"/>
		</HBox>

		<!-- 工作区域，除了标题栏外的内容都放在这个大的Box区域 -->

		<VBox width="auto" height="auto">
			<Control height="30"/>
			<Label text_id="STRID_APPLYEFFECTS_CHECKFILED_TITLE" valign="center" margin="24,0,8,12" text_align="right,vcenter"  normal_text_color="#CSPColor_Content" font="system_bold_16"/>
			<Label text_id="STRID_APPLYEFFECTS_CHECKFILED_CONTENT1" valign="center" margin="24,0,24,0" text_align="right,vcenter"  normal_text_color="#CSPColor_Content" font="system_14"/>
			<Label text_id="STRID_APPLYEFFECTS_CHECKFILED_CONTENT2" valign="center" margin="24,0,24,0" text_align="right,vcenter"  normal_text_color="#CSPColor_Content" font="system_14"/>

			<Control height="30"/>

			<!--按钮区-->
			<HBox margin="8,8,8,8"  halign="center" height="auto">
				<Control />
				<Button margin="4,0,4,0" name="btn_OK" text_id="STRING_OK" width="90" height="30" border_size="1" border_round="2,2" border_color="#CSPColor_Separator" fade_hot="false"
						normal_text_color="#FFFFFF" bkcolor="#CSPColor_BlueButton" hot_color="#CSPColor_BlueButtonHot" pushed_color="#CSPColor_BlueButtonPush"/>

			</HBox>

		</VBox>



	</VBox>
</Window>